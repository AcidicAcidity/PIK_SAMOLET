# --- PostgreSQL ---
POSTGRES_DB=developer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Порт БД на компьютере (для DataGrip/pgAdmin): localhost:5433
DB_EXTERNAL_PORT=5433

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# 1 — режим разработки, 0 — продакшен
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# 1 — заполнить БД демо-данными при первом запуске
SEED_DEMO=1

# --- Почта для 2FA ---
# В Docker письма автоматически ловит Mailpit: http://localhost:8025
# Без Docker и без SMTP коды печатаются в консоль сервера.
# Чтобы отправлять настоящие письма — раскомментируйте и заполните:
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=465
# EMAIL_USE_SSL=1
# EMAIL_HOST_USER=you@yandex.ru
# EMAIL_HOST_PASSWORD=app-password
DEFAULT_FROM_EMAIL=Новый Горизонт <no-reply@novyi-gorizont.local>

# --- Порты на компьютере (поменяйте, если заняты) ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
MAILPIT_PORT=8025
